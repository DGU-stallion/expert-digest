# Copy this file to .env and edit with your real API keys.
#   cp .env.example .env
#
# ExpertDigest reads these environment variables at startup.
# See src/expert_digest/cli.py:_load_pipeline_env for usage.

# ── Pipeline LLM Configuration ──────────────────────────────────────────
# Two LLM tiers: "fast" (lightweight tasks) and "reasoning" (heavy tasks).
# Both use the same DeepSeek API endpoint; only the model name differs.

# Fast tier — used for expression analysis, chapter review, encoding, etc.
PIPELINE_FAST_BASE_URL=https://api.deepseek.com/anthropic
PIPELINE_FAST_API_KEY=sk-your-deepseek-api-key-here
PIPELINE_FAST_MODEL=deepseek-v4-flash

# Reasoning tier — used for content analysis, chapter writing, editing, etc.
PIPELINE_REASONING_BASE_URL=https://api.deepseek.com/anthropic
PIPELINE_REASONING_API_KEY=sk-your-deepseek-api-key-here
PIPELINE_REASONING_MODEL=deepseek-v4-pro
